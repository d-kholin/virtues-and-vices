PORT=5173
APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Exact Pocket ID sub claims, comma-separated. No public registration.
ALLOWED_SUBJECTS=your-sub,your-spouses-sub
# Local development only. Never enabled in production or on a public bind address.
DEMO_MODE=false
HOST=127.0.0.1

# Optional explicit opt-in for testing the unauthenticated demo on a trusted LAN.
ALLOW_NETWORK_DEMO=false
# Extra exact origins permitted for CSRF checks, comma-separated.
ADDITIONAL_ORIGINS=
